projection;
//strict ( 2 ); //Uncomment this line in order to enable strict mode 2. The strict mode has two variants (strict(1), strict(2)) and is prerequisite to be future proof regarding syntax and to be able to release your BO.

define behavior for ZCD_C_TRAVEL_AP alias TravelProccesor
use etag
{

  field ( readonly ) TotalPrice;
  use create;
  use update;
  use delete;

  use action acceptTravel;
  use action rejectTravel;
  use action createTravelbyTemplate;

  use association _Booking { create; }
}

define behavior for ZCD_C_BOOKING_AP alias BookingProccesor
{
  use update;
  //use delete;

  use association _Travel;
  use association _BookSupplement { create; }
}

define behavior for ZCD_C_BOOKSUP_AP alias SupplementProccesor
{
  use update;
  //use delete;

  use association _Travel;
  use association _Booking;
}